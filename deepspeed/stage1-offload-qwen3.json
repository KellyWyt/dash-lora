{
    "optimizer": {
        "type": "AdamW",
        "params": {
          "lr": "auto",
          "betas": "auto",
          "eps": "auto",
          "weight_decay": "auto",
          "torch_adam": true
        }
      },
      "scheduler": {
        "type": "WarmupDecayLR",
        "params": {
          "total_num_steps": "auto",
          "warmup_min_lr": "auto",
          "warmup_max_lr": "auto",
          "warmup_num_steps": "auto"
        }
      },
    "bf16": {
      "enabled": "auto"
    },  
    "fp16": {
      "enabled": false
    },  
    "zero_optimization": {
      "stage": 1,  
      "offload_optimizer": {
        "device": "cpu"
      }
    },
    "gradient_accumulation_steps": "auto",
    "gradient_clipping": "auto",
    "steps_per_print": 2000,
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": "auto",
    "wall_clock_breakdown": false
}